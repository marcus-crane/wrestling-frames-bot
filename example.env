# Plex server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token-here
PLEX_PPV_LIBRARY=Wrestling (PPVs)
PLEX_TV_LIBRARY=Wrestling (TV)

# Weights
# 0 = TV only, 1 = PPV only, 0.25 = 25% PPV / 75% TV
PPV_WEIGHT=0.25
TV_SHOW_FILTERS=Raw,SmackDown

# Bluesky
BSKY_HANDLE=your-handle.bsky.social
BSKY_PASSWORD=your-app-password-here

# Anthropic (for alt text generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugo site (optional)
HUGO_SITE_PATH=
